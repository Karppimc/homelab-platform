{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "image", "replicas", "port", "resources"],
  "properties": {
    "name": {
      "description": "Name of the service",
      "type": "string",
      "pattern": "^[a-z]([a-z0-9-]{0,51}[a-z0-9])?$"
    },
    "partOf": {
      "type": "string",
      "pattern": "^([A-Za-z0-9]([A-Za-z0-9_.-]{0,61}[A-Za-z0-9])?)?$"
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "description": "Image without a tag or digest",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./_-]*(:[0-9]+/[a-z0-9./_-]+)?$"
        },
        "tag": {
          "description": "Immutable tag; latest is not allowed",
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
          "not": { "enum": ["latest"] }
        }
      }
    },
    "replicas": { "type": "integer", "minimum": 1, "maximum": 10 },
    "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "health": {
      "type": "object",
      "required": ["livenessPath", "readinessPath"],
      "additionalProperties": false,
      "properties": {
        "livenessPath": { "type": "string", "pattern": "^/" },
        "readinessPath": { "type": "string", "pattern": "^/" }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["enabled", "path", "interval"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "pattern": "^/" },
        "interval": { "type": "string", "pattern": "^[0-9]+(s|m)$" }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "additionalProperties": false,
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" }
          }
        },
        "limits": {
          "type": "object",
          "required": ["memory"],
          "additionalProperties": false,
          "properties": {
            "memory": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" }
          }
        }
      }
    },
    "env": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
      "additionalProperties": { "type": "string" }
    },
    "runAsUser": { "type": "integer", "minimum": 1 },
    "runAsGroup": { "type": "integer", "minimum": 1 }
  }
}
