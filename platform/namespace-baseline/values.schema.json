{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "owner", "quota", "sourceRepos"],
  "properties": {
    "name": {
      "description": "Name of the workload: its namespace and its Argo CD project",
      "type": "string",
      "pattern": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$",
      "not": {
        "enum": ["default", "argocd", "kyverno", "monitoring", "kube-system", "kube-public", "kube-node-lease"]
      }
    },
    "owner": {
      "description": "Team or person that owns the workload; must be a valid label value",
      "type": "string",
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9_.-]{0,61}[A-Za-z0-9])?$"
    },
    "quota": {
      "description": "Size of the ResourceQuota",
      "type": "string",
      "enum": ["small", "medium", "large"]
    },
    "sourceRepos": {
      "description": "Repositories the workload's Argo CD Applications may deploy from",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(https://|oci://)[^*]+$"
      }
    }
  }
}
